generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  DESIGNING
  OPTION_SELECTED
  IMAGE_GENERATED
  WAITING_CONFIRMATION
  SHOPIFY_CREATED
  WAITING_PAYMENT
  PAID
  PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
  FAILED
}

model UserMemory {
  id            String   @id @default(cuid())
  discordUserId String   @unique
  username      String
  profile       String   @default("")
  stage         String   @default("inquiry")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CardProject {
  id                 String   @id @default(cuid())
  discordUserId      String
  status             String   @default("inquiry")
  originalPrompt     String
  currentPrompt      String   @default("")
  selectedStyleId    String?
  finalDesignSummary String?
  shopifyProductId   String?
  shopifyProductUrl  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  styleOptions       CardStyleOption[]
  feedbackLogs       FeedbackLog[]
  shopifyLogs        ShopifyProductLog[]

  @@index([discordUserId, createdAt])
}

model CardStyleOption {
  id            String   @id @default(cuid())
  cardProjectId String
  styleId       String
  styleName     String
  designSummary String
  imagePrompt   String
  imageUrl      String?
  selected      Boolean  @default(false)
  createdAt     DateTime @default(now())

  cardProject   CardProject @relation(fields: [cardProjectId], references: [id], onDelete: Cascade)

  @@index([cardProjectId, createdAt])
}

model FeedbackLog {
  id            String   @id @default(cuid())
  cardProjectId String
  discordUserId String
  feedbackText  String
  oldPrompt     String
  newPrompt     String
  createdAt     DateTime @default(now())

  cardProject   CardProject @relation(fields: [cardProjectId], references: [id], onDelete: Cascade)

  @@index([cardProjectId, createdAt])
}

model ShopifyProductLog {
  id                String   @id @default(cuid())
  cardProjectId     String
  discordUserId     String
  shopifyProductId  String
  shopifyProductUrl String
  title             String
  price             String
  sku               String
  createdAt         DateTime @default(now())

  cardProject       CardProject @relation(fields: [cardProjectId], references: [id], onDelete: Cascade)

  @@index([cardProjectId, createdAt])
}

model ConversationLog {
  id            String   @id @default(cuid())
  discordUserId String
  role          String
  content       String
  createdAt     DateTime @default(now())

  @@index([discordUserId, createdAt])
}

model ShopifyShop {
  id                 String   @id @default(cuid())
  shop               String   @unique
  accessToken        String
  scope              String?
  installedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt
  webhookStatus      String   @default("pending")
  webhookTopics      String   @default("")
  reauthorizeRequired Boolean @default(false)

  @@index([installedAt])
}

model ShopifySession {
  id          String   @id @default(cuid())
  shop        String   @unique
  accessToken String   @map("access_token")
  scope       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("shopify_sessions")
}

model Order {
  id                  String      @id @default(cuid())
  orderNo             String      @unique
  discordUserId       String
  discordChannelId    String?
  discordMessageId    String?
  cardProjectId       String?
  originalPrompt      String?
  selectedOption      String?
  selectedStyle       String?
  designPrompt        String?
  imageUrl            String?
  productTitle        String?
  productDescription  String?
  price               Decimal?    @db.Decimal(10, 2)
  currency            String      @default("USD")
  shippingType        String?
  shippingAddressJson Json?
  shopifyShop         String?
  shopifyProductId    String?
  shopifyProductGid   String?
  shopifyVariantId    String?
  shopifyVariantGid   String?
  shopifyProductUrl   String?
  shopifyCheckoutUrl  String?
  shopifyOrderId      String?
  shopifyOrderGid     String?
  shopifyOrderName    String?
  status              OrderStatus @default(DRAFT)
  paidAt              DateTime?
  shippedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  metadata            Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([discordUserId])
  @@index([status])
  @@index([shopifyProductId])
  @@index([shopifyOrderId])
  @@index([orderNo])
}
