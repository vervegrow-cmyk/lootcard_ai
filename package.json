{
  "name": "cardforge-ai",
  "version": "1.0.0",
  "private": true,
  "description": "CardForge AI Discord custom trading card agent with Claude, Shopify, Prisma, and Railway deployment support.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "start": "node dist/index.js",
    "provider:health-check": "node ./scripts/provider-health-check.js",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:studio": "node ./node_modules/prisma/build/index.js studio"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^6.19.3",
    "@remix-run/express": "latest",
    "@remix-run/node": "latest",
    "@remix-run/react": "latest",
    "@shopify/app-bridge-react": "latest",
    "@shopify/polaris": "latest",
    "@shopify/shopify-api": "latest",
    "@shopify/shopify-app-remix": "latest",
    "@shopify/shopify-app-session-storage-prisma": "latest",
    "@types/cookie-parser": "^1.4.10",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
