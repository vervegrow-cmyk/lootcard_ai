# ============================================================
# CardForge AI Environment Variables
# Copy this file to `.env` for local development.
# ============================================================

# ----- Runtime ------------------------------------------------
PORT=3000
ECHO_BOT_MODE=false
MOCK_IMAGE_MODE=true

# ----- Discord ------------------------------------------------
# Paste the Bot Token from Discord Developer Portal > Bot
# Do not paste Client Secret, Application ID, or a token label string.
DISCORD_BOT_TOKEN=

# ----- Database -----------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/cardforge_ai?schema=public

# ----- Shopify ------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
DEFAULT_CARD_PRICE=29.99

# ----- AI Provider Order --------------------------------------
AI_PROVIDER_ORDER=anthropic,openai,openrouter,kimi,deepseek,dashscope,zhipu,google,xai

# ----- Anthropic ----------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ----- OpenAI -------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- OpenRouter ---------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://github.com/vervegrow-cmyk/lootcard_ai
OPENROUTER_APP_NAME=CardForge AI

# ----- Kimi / Moonshot ----------------------------------------
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k

# ----- DeepSeek -----------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ----- DashScope / Qwen ---------------------------------------
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# ----- Zhipu AI -----------------------------------------------
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# ----- Google Gemini ------------------------------------------
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# ----- xAI / Grok ---------------------------------------------
XAI_API_KEY=
XAI_MODEL=grok-2-latest
